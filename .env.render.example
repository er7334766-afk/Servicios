# Example environment variables for Render deployment
# Replace placeholders with real values in Render dashboard (do NOT commit secrets).

# Database
DB_HOST=your-db-host
DB_PORT=1433
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Azure Storage (optional)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...;
AZURE_CONTAINER_NAME=uploads

# Session / Cookies
SESSION_COOKIE_NAME=servi_sess
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none

# Redis (recommended for sessions)
REDIS_URL=redis://:password@hostname:6379

# Azure Log Analytics
LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
LOG_ANALYTICS_WORKSPACE_KEY=your-workspace-primary-key
LOG_ANALYTICS_LOG_TYPE=ServiciosSecurity

# Other
NODE_ENV=production
